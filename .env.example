NODE_ENV=development
PORT=5000
# PostgreSQL connection URL, for example postgresql://user:password@localhost:5432/telegram_signal_desk
DATABASE_URL=
# Generate a unique random value of at least 32 characters.
JWT_SECRET=
# Stable random secret used to protect saved Telegram sessions and MetaAPI credentials.
# Do not rotate without re-encrypting saved values.
SESSION_ENCRYPTION_KEY=
# Telegram credentials are optional until Telegram integration is enabled.
API_ID=
API_HASH=
# Which Telegram driver a process talks to: gramjs (what is deployed) or teleproto (the maintained fork;
# gramjs is archived). Unset or unrecognised means gramjs, and an unrecognised value is logged rather than
# guessed at. A driver that cannot be handed over whole - a module this runtime cannot load, or one missing an
# operation the app calls - is refused at boot instead of substituted, because a session written by one driver and
# read by another is how an account loses its login. server/services/telegram-driver.js is the only file that
# reads this, and server/services/telegram/teleproto-adapter.ts is the second driver; the two are held to the
# same 45 operations by server/test/telegram-driver-parity.test.js.
# TELEGRAM_DRIVER=gramjs
# Server-only MetaAPI provisioning token; never add this to VITE_* variables or frontend code.
METAAPI_PROVISIONING_TOKEN=
# Frontend origin(s), comma separated. Local Vite default:
CLIENT_URL=http://localhost:5173
# Optional MetaAPI HTTPS API base URL; leave unchanged for the standard endpoint.
META_API_URL=https://mt-provisioning-api-v1.agiliumtrade.agiliumtrade.ai
PG_POOL_MAX=5
# Enable the MetaAPI execution runtime. Use "true" only when live execution is intended.
# Without it, no order and no break-even stop move is ever sent to the broker.
AUTO_TRADING_RUNTIME_ENABLED=false
# Idle MetaAPI account cleanup (server/services/inactivity.js). Accounts stay deployed;
# an account whose user has not signed in, saved settings, or executed a signal for
# DELETION_DAYS is deleted from MetaAPI so it stops being billed, and warned at
# WARNING_DAYS. Set INACTIVITY_CLEANUP_ENABLED=false to stop the sweep entirely.
INACTIVITY_CLEANUP_ENABLED=true
INACTIVITY_WARNING_DAYS=25
INACTIVITY_DELETION_DAYS=30
INACTIVITY_SWEEP_LIMIT=25
# Break-even sweeps move the stop of a trade Signal Desk opened to the entry price (plus
# the offset set in Risk settings) once the market has travelled far enough in favour of the
# trade, and keep ratcheting it at the trailing distance when a trailing stop is on. This only
# throttles how often the worker checks; it never enables execution. The name is kept from the
# break-even feature because the same sweep serves both protections - there is one cadence, and
# turning on a trail cannot double the write rate to a broker.
BREAK_EVEN_SWEEP_INTERVAL_MS=5000
# Supabase Auth project settings. The URL and publishable key are public; the secret
# key is server-only (secret/service-role) and must never be exposed to the browser.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Comma-separated emails that always hold the admin role. The workspace owner
# address is included by default even when this is empty.
ADMIN_EMAILS=
# Frontend build-time Supabase values (client/.env, or the static site's build env).
# Password recovery also works without them through GET /api/config at runtime.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Flutterwave billing. The secret key is server-only; never prefix it with VITE_.
# Collect these four from Flutterwave's Settings -> API keys and Webhooks screens.
FLW_SECRET_KEY=
FLW_PUBLIC_KEY=
# The static string you paste into Flutterwave's webhook settings; every webhook
# request must carry it in the verif-hash header. While this is empty the endpoint
# answers 503 to everything (a wrong or missing hash is a 401), so a
# half-configured deploy cannot hand out plans to whoever calls it.
FLW_WEBHOOK_HASH=
# Encryption key: only needed if the account has "data validation and encryption"
# switched on for webhooks. Leave empty otherwise; nothing here decrypts a payload.
FLW_ENCRYPTION_KEY=
# Optional HTTPS base override; leave empty for https://api.flutterwave.com
FLW_API_URL=
# The currency the billing page defaults to. NGN (default) or USD; anything else
# is read as NGN, and the visitor can still switch in the UI.
FLW_CURRENCY=NGN
# Payment methods are not configurable here, on purpose: each checkout sends the
# country and the method list that the chosen currency can actually settle - USD
# is card-only with country US, NGN offers card, bank transfer and ussd with
# country NG. Left to its own devices Flutterwave reads the payer's IP and shows
# a Nigerian a naira page even for a dollar price, which no card can pay. See
# CURRENCY_CHECKOUT_PRESENTATION in server/services/flutterwave.js.
# Interval for the Flutterwave payment plans that drive automatic renewal:
# monthly (default), quarterly, annually, or biannually (Flutterwave also accepts
# hourly, daily, weekly and "every x y", but the panel offers these four).
FLW_PLAN_INTERVAL=monthly
# Fallback prices in the SMALLEST currency unit - hundredths, i.e. multiply by 100
# to read the amount: Starter 6000000 = NGN 60,000, Pro 10500000 = NGN 105,000,
# Premium 15000000 = NGN 150,000; USD 3900 = $39, 6900 = $69, 9900 = $99.
# Flutterwave's API takes the MAIN unit (60000, not 6000000): the division happens
# once, in server/services/flutterwave.js, and every comparison at the webhook is
# done in minor units again - so an environment that put 600 here would be read as
# NGN 6.00 and refused as below the minimum charge, not silently charged 60,000.
# They are set against the per-account cost MetaAPI bills this workspace, so a paid
# plan is never priced below the accounts it allows. Active prices are stored in the
# plans table (one row per plan, price_ngn_minor and price_usd_minor) and set from
# Admin Panel -> Pricing & Plans; these values are used only while no price has been
# saved there, and a cleared price returns to them. A Flutterwave payment plan per
# (plan, currency) is re-synced on every price save so renewals charge the new
# amount; the legacy Paystack plan codes are not carried over, which is exactly why
# checkout falls back to a one-time verified charge until an admin presses Sync.
# The free tier has no price and no plan: it is what an account with no active
# subscription gets, and it allows no trading account at all.
FLW_PLAN_STARTER_AMOUNT=
FLW_PLAN_STARTER_USD_AMOUNT=
FLW_PLAN_PRO_AMOUNT=
FLW_PLAN_PRO_USD_AMOUNT=
FLW_PLAN_PREMIUM_AMOUNT=
FLW_PLAN_PREMIUM_USD_AMOUNT=
